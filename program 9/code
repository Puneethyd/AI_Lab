            unbound = sorted({v for v in re.findall(r"[A-Za-z0-9_']+", e1 + " " + e2)
                              if is_variable(v) and v not in theta
                              and not any(occurs(v, b) for b in theta.values())} )
            note = ""
            if unbound and any(occurs(u, b) for b in theta.values() for u in unbound):
